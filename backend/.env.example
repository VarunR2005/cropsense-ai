# Copy to .env and fill in real values. NEVER commit .env
DATABASE_URL=postgresql+psycopg2://cropsense_user:CHANGE_ME@localhost:5432/cropsense
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# Free key from https://openweathermap.org (needed for the weather endpoint)
OPENWEATHER_API_KEY=
# How long a city's weather is reused before calling the API again
WEATHER_CACHE_MINUTES=30
